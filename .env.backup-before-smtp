# Perimity — local environment variables

# NEVER commit this .env file.

# ---------- Database ----------

POSTGRES_USER=perimity
POSTGRES_PASSWORD=change_me_local_only
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=entrylogdb

# ---------- JWT ----------

# Must remain exactly the same for every microservice.

JWT_SECRET=this_is_a_long_random_string_for_perimity_jwt
JWT_EXPIRY_HOURS=24

# ---------- Internal service-to-service key ----------

INTERNAL_API_KEY=perimity_internal_key_local

# ---------- Authentication policy ----------

PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_LINK_EXPIRY_MINUTES=30

# ---------- OTP policy ----------

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=3
OTP_REQUEST_WINDOW_MINUTES=15

# ---------- Bulk upload limits ----------

BULK_MAX_ROWS=1000
UPLOAD_MAX_PHOTO_MB=2
UPLOAD_MAX_DOCUMENT_MB=5

# ---------- First Super Admin ----------

SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=Perimity@@2026

# ---------- Email (SMTP) ----------

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=perimity.info@gmail.com
MAIL_PASSWORD=lgdgkhefqvslovhg
MAIL_FROM_NAME=Perimity

# Real email via Gmail. Commented out on purpose: uncomment these four
# ONLY after MAIL_PASSWORD above holds a real 16-character App Password
# from perimity.info@gmail.com. Uncommenting with the placeholder still
# in place makes every OTP and pass email fail SMTP auth, which is worse
# than MailHog. Leave them commented and mail keeps going to MailHog at
# http://localhost:8025 as usual.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_AUTH=true
#SMTP_STARTTLS=true

# ---------- RabbitMQ ----------

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---------- Redis ----------

REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Object storage ----------

AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=perimity-bucket

# ---------- QR token encryption ----------

# Must be exactly 32 characters.

QR_AES_KEY=IboMqF7flUDhlLDEWNKjKW4YGB7xOBEfiaqqJ0wrvQU=

# ---------- Frontend ----------

VITE_API_BASE_URL=http://localhost

# Broker hostname. 'rabbitmq' is the Compose service name and only resolves
# from inside the Compose network. Services run from an IDE talk to the
# published port on the host, so localhost is correct here. Docker overrides
# this via the environment when the services are containerised on Day 22.
RABBITMQ_HOST=localhost

# ---------- Local mail (Day 9) ----------
# MailHog, not Gmail. Same pattern as RABBITMQ_HOST above: the later value
# wins, so the Gmail settings at lines 52-56 stay intact for whoever needs
# them. A development run that sends real email is a mistake you make once,
# and a 600-row bulk upload on Day 10 makes it 600 times.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@example.com
# Origins the APIs accept from a browser. Comma-separated, no spaces.
# Add a teammate's LAN address here (http://192.168.x.x:5173) rather than
# editing SecurityConfig - a blocked origin surfaces as "could not reach the
# server" with a perfectly healthy backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
