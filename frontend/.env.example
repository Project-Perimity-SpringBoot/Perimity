# ── API routing ──────────────────────────────────────────────────────────────
# proxy  : all six services behind one origin (dev proxy / nginx). Recommended.
# direct : hit each service on its own port. For debugging one service alone.
VITE_API_MODE=proxy
VITE_BACKEND_HOST=localhost

# Leave these EMPTY in proxy mode. Each service module already carries the full
# path (/api/auth/login), so an origin here is all that is needed — putting
# "/api" in produces /api/api/auth/login and a 404 from the dev server.
#
# Only set them to point at one service in isolation, and then as a bare origin:
#   VITE_AUTH_URL=http://localhost:8081
VITE_AUTH_URL=
VITE_USER_URL=
VITE_GATEPASS_URL=
VITE_CAMPUS_URL=
VITE_GUARD_URL=
VITE_QR_URL=

# ── Mock layer ───────────────────────────────────────────────────────────────
# Master switch. A per-service flag below OVERRIDES it, so each member flips
# their own service to the real backend the moment their controllers land
# without waiting for anyone else. A single global switch would mean nobody
# integrates until everybody can.
VITE_USE_MOCKS=false

# Leave unset to follow the master switch. Set to false to hit the real service.
# VITE_USE_MOCKS_AUTH=false
# VITE_USE_MOCKS_USER=false
# VITE_USE_MOCKS_GATEPASS=false
# VITE_USE_MOCKS_CAMPUS=false
# VITE_USE_MOCKS_GUARD=false
# VITE_USE_MOCKS_QR=false

# ── Session ──────────────────────────────────────────────────────────────────
VITE_IDLE_TIMEOUT_MINUTES=30
VITE_EXPIRY_WARNING_MINUTES=5
VITE_GUARD_EXPIRY_WARNING_MINUTES=15

# Backend serialises LocalDateTime with no zone. Must match the services'
# configured timezone or every timestamp is silently wrong.
VITE_CAMPUS_TIMEZONE=Asia/Kolkata


# ── Blocker workarounds (delete each flag the day its blocker clears) ────────
VITE_DEFAULT_CAMPUS_ID=1                  # B12 — GET /campuses needs a token
VITE_ENABLE_PASS_DOWNLOAD=true            # B1  — CLEARED. qr-service serves QR/PDF bytes
VITE_ENABLE_STUDENT_ENTRY_HISTORY=false   # B9  — students get 403 on entry-logs
VITE_ENABLE_GUARD_MANUAL_LOOKUP=false     # B8  — no lookup/override endpoints
VITE_ENABLE_BLOCKLIST_CHECK_LINE=false    # B10 — faculty get 403 on blocklist
