# Copy to .env. These are the six service ports from docker-compose.yml.
VITE_AUTH_URL=http://localhost:8081
VITE_USER_URL=http://localhost:8082
VITE_GATEPASS_URL=http://localhost:8083
VITE_CAMPUS_URL=http://localhost:8084
VITE_GUARD_URL=http://localhost:8085
VITE_QR_URL=http://localhost:8086

# Sent to guard-service with every shift start, for the session's device record.
VITE_APP_VERSION=1.0.0
