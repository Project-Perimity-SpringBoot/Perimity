# Copy to .env.local (git-ignored) and adjust if your ports differ.
#
# SIX BASE URLS, not one. There is no API gateway in this project - each
# service is reached directly on its own port. When the gateway arrives these
# all become the same host and nothing else changes.
VITE_AUTH_URL=http://localhost:8081
VITE_USER_URL=http://localhost:8082
VITE_GATEPASS_URL=http://localhost:8083
VITE_CAMPUS_URL=http://localhost:8084
VITE_GUARD_URL=http://localhost:8085
VITE_QR_URL=http://localhost:8086
