# Perimity — environment variable template
#
# HOW TO USE:
#   1. Copy this file and rename the copy to exactly ".env"
#   2. Fill in the real values in ".env"
#   3. NEVER commit ".env" — it is already in .gitignore
#
# Only this file (.env.example) is committed, with fake placeholder values.
# Every value below is read by docker-compose.yml, so .env must exist before
# you run `docker compose up`.

# ---------- Database ----------
POSTGRES_USER=perimity
POSTGRES_PASSWORD=change_me_local_only
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=entrylogdb

# ---------- JWT ----------
# Must be the SAME value in every service, or tokens won't validate across services.
# Generate a long random string (at least 32 characters).
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRY_HOURS=24

# ---------- Internal service-to-service key ----------
# Protects /internal/** endpoints that services call on each other.
INTERNAL_API_KEY=change_me_internal_key

# ---------- Authentication policy (SRS v1.1) ----------
# Password rules for Super Admin, Campus Admin, Faculty, Student, Guard.
# Visitors never have a password.
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_LINK_EXPIRY_MINUTES=30

# ---------- OTP policy ----------
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Max OTP requests per email inside the window below (FR-REG-7).
OTP_MAX_REQUESTS=3
OTP_REQUEST_WINDOW_MINUTES=15

# ---------- Bulk upload limits ----------
BULK_MAX_ROWS=1000
UPLOAD_MAX_PHOTO_MB=2
UPLOAD_MAX_DOCUMENT_MB=5

# ---------- First Super Admin (seeded once on first startup) ----------
# Use a neutral address. Do NOT use a real institution's domain.
# Change this password immediately after first login.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change_me_on_first_login

# ---------- Email (SMTP) ----------
# For Gmail, use an App Password, NOT your real Gmail password.
# Generate at: Google Account > Security > 2-Step Verification > App passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your_16_char_app_password
# Shown as the sender name on OTP and pass emails. Product name, not a campus.
MAIL_FROM_NAME=Perimity

# ---------- RabbitMQ ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Object storage (S3 / MinIO) ----------
# Leave as placeholders until Day 23 (AWS deployment). Use LocalStack or MinIO
# before that.
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=perimity-bucket

# ---------- QR token encryption ----------
# AES-256 key. Must be exactly 32 characters.
QR_AES_KEY=change_me_exactly_32_characters!!

# ---------- Frontend ----------
# Localhost for development. On the cloud VM, change to the server's public IP.
VITE_API_BASE_URL=http://localhost
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage-dev
STORAGE_PRESIGN_MINUTES=15
UPLOAD_MAX_SHEET_MB=5